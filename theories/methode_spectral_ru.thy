  (Ñ‚.Ðµ. ÑÑƒÑ‰ÐµÑÑ‚Ð²ÑƒÑŽÑ‚ Ð¿Ñ€Ð¾ÑÑ‚Ñ‹Ðµ p1, p2 Ñ‚Ð°ÐºÐ¸Ðµ, Ñ‡Ñ‚Ð¾ prime_i n1 = p1 Ð¸
  prime_i n2 = p2).

  Ð”Ð»Ñ Ð´Ð²ÑƒÑ… ÑÐ¾ÑÑ‚Ð°Ð²Ð½Ñ‹Ñ… C1, C2 Ð½Ðµ ÑÑƒÑ‰ÐµÑÑ‚Ð²ÑƒÐµÑ‚ Ð¿Ð°Ñ€Ñ‹ (n1, n2) Ñ‚Ð°ÐºÐ¾Ð¹, Ñ‡Ñ‚Ð¾
  C1 = prime_i n1 Ð˜ C2 = prime_i n2, Ñ‡Ñ‚Ð¾ Ð´ÐµÐ»Ð°ÐµÑ‚ Ð²Ñ‹Ñ‡Ð¸ÑÐ»ÐµÐ½Ð¸Ðµ ÑÐ¾Ð¾Ñ‚Ð²ÐµÑ‚ÑÑ‚Ð²ÑƒÑŽÑ‰ÐµÐ³Ð¾
  RsP Ð½ÐµÐ²Ð¾Ð·Ð¼Ð¾Ð¶Ð½Ñ‹Ð¼ Ð² Ð°ÐºÑÐ¸Ð¾Ð¼Ð°Ñ‚Ð¸Ñ‡ÐµÑÐºÐ¸Ñ… Ñ€Ð°Ð¼ÐºÐ°Ñ… Ð¼ÐµÑ‚Ð¾Ð´Ð°.
\<close>


theorem composite_pair_no_rsp_positions:
  fixes C1 C2 :: nat
  assumes "~ prime C1" and "~ prime C2"
  shows "~ (EX n1 n2. n1 >= 1 & n2 >= 1 & n1 ~= n2
                    & C1 = prime_i n1 & C2 = prime_i n2)"
proof
  assume "EX n1 n2. n1 >= 1 & n2 >= 1 & n1 ~= n2
              & C1 = prime_i n1 & C2 = prime_i n2"
  then obtain n1 n2 where
    p1: "C1 = prime_i n1" and p2: "C2 = prime_i n2" by blast
  have "prime (prime_i n1)" by (rule prime_i_is_prime)
  with p1 have "prime C1" by simp
  with assms(1) show False by contradiction
qed


