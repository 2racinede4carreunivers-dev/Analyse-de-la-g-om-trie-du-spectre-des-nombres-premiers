def valider_n15(k):
    d = DOC15[k]; n = 15
    ok = (frac(d['const']['aA']) == aAf(k)) and (frac(d['const']['aB']) == aBf(k)) and (frac(d['const']['dA']) == dAf(k)) and (frac(d['const']['dB']) == dBf(k))
    CUR.append((ok, r"$k=%d$ : $\alpha_A=%s$, $\alpha_B=%s$, $\delta_A=%s$, $\delta_B=%s$ (valeurs recalculées) \hfill %s" % (k, fmt(aAf(k)), fmt(aBf(k)), fmt(dAf(k)), fmt(dBf(k)), OKC if ok else KOC)))
    rec(r"$k=%d$, $n=15$ : constantes $\alpha_A,\alpha_B,\delta_A,\delta_B$" % k, ok)
    egal(r"$k=%d$ : $S_A(k,15)$ (formule fermée)" % k, SAf(k,n), d['SA'])
    egal(r"$k=%d$ : $S_B(k,15)$ (formule fermée)" % k, SBf(k,n), d['SB'])
    r = (SAf(k,n)-SAf(k,10)) / (SBf(k,n)-SBf(k,10))
    egal(r"$k=%d$ : $\Delta S_A/\Delta S_B=1/k$" % k, r, F(1,k))
    A = A_terms(k,n); B = B_terms(k,n)
    egal(r"$k=%d$ : $\Sigma A$ (somme des 15 termes)" % k, sum(A), d['SA'])
    egal(r"$k=%d$ : $\Sigma B$ (somme des 15 termes)" % k, sum(B), d['SB'])
    badt = [i for i,(a,b) in d['terms'].items() if (A[i-1], B[i-1]) != (a,b)]
    ligne(r"$k=%d$ : %d termes $A(k,15,i)$ et $B(k,15,i)$ du tableau" % (k, len(d['terms'])), not badt,
          "tous conformes", r"écarts aux positions %s" % ", ".join(str(i) for i in badt))
    D = {('13','-'):SAf(k,n)-k**13, ('13','+'):SAf(k,n)+k**13, ('12','+'):SAf(k,n)+k**12, ('12','-'):SAf(k,n)-k**12}
    for (pos,sg,dg,pc,etat) in d['trials']:
        Dg = D[(str(pos),sg)]
        Pc = (SBf(k,n)-Dg)/k**6
        ok = (Dg == dg) and (int(Pc) == pc) and (not mr(pc))
        rec(r"$k=%d$ : essai pos%d%s (Digamma, $P$ candidat, composé)" % (k,pos,sg), ok)
        CUR.append((ok, r"$k=%d$, pos%d$%s$ : Digamma $%s$ ; $P=%s$ %s \hfill %s" % (k,pos,sg,fmt(Dg),fmt(int(Pc)), 'composé' if not mr(pc) else 'PREMIER', OKC if ok else KOC)))
    P10 = d['P10']; rb = pi_lucy(P10)
    egal(r"$k=%d$ : rang\_base $=\pi(%s)$" % (k, fmt(P10)), rb, d['rb'])
    egal(r"$k=%d$ : rang\_cible $=$ rang\_base $+5$" % k, rb + 5, d['rc'])
    P15 = d['P15']; npr = sum(1 for m in range(P10+1, P15+1) if mr(m))
    ligne(r"$k=%d$ : $P(k,15)=%s$ est le $5^{\text{e}}$ premier après $P(k,10)$" % (k, fmt(P15)), mr(P15) and npr == 5,
          r"premier ; %d premiers dans $]P(k,10),P(k,15)]$" % npr, r"premier : %s ; %d premiers dans l'intervalle (5 attendus)" % ('oui' if mr(P15) else 'non', npr))
    egal(r"$k=%d$ : Digamma$(k,15)=S_B-P\times k^{6}$" % k, SBf(k,n) - P15*k**6, d['Dig15'])
    box(r"section 4.%d : rapport $1/%d$, $n=15$ (niveaux 1 à 5)" % ({13:1,42:2,54:3}[k], k))
