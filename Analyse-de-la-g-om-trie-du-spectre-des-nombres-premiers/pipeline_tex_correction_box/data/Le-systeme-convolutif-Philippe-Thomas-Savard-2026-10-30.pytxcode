import re
def _lab(e, d):
    t = e.replace('primepi(', r'\pi(')
    t = re.sub(r'\*\*(\d+)', r'^{\1}', t)
    t = t.replace('*', r'\times ').replace('+', r'+').replace('/', r'/')
    return r"$%s = %s$" % (t, d)
def VG(titre, entrees):
    for e, d in entrees:
        chk(_lab(e, d), e, d)
    box(titre)
