ecarts = []; nb = 0
cnt = {'U':0,'M':0,'A':0}
for k in range(10, 112):
    p, st, br = TAB37[k]
    pr = [(l,v) for l,v in cands(k) if mr(v)]
    cls = 'A' if not pr else ('U' if len(pr) == 1 else 'M')
    cnt[cls] += 1
    nb += 1
    if st.startswith('Methode') or st == 'REGLE':
        ok = True; msg = ''
        if k == 11:
            ok = mr(int(p)) and pi_lucy(int(p)) == 121982
            msg = r"règle spéciale $k=11$ : $P=%s$ premier, rang $\pi(P)=%s$" % (fmt(int(p)), fmt(pi_lucy(int(p))))
        elif k == 27:
            P27 = (SBf(27,10) - (SAf(27,10) - (2*27**8 - 27**6))) / 27**6
            ok = (P27 == int(p)) and mr(int(p))
            msg = r"règle spéciale $k=27$ : $(S_B-D)/k^6=%s$, document $%s$" % (fmt(P27), fmt(int(p)))
        rec(r"table 3.7, $k=%d$ (règle spéciale)" % k, ok)
        if not ok: ecarts.append(r"$k=%d$ : %s \hfill %s" % (k, msg, KOC))
        continue
    if p == '---':
        docl = 'A'; ok = (cls == 'A'); msg = r"aucun candidat premier attendu ; calcul : %s" % (", ".join("$%s$" % fmt(v) for l,v in pr) or "aucun")
    else:
        docl = 'M' if 'MULTIPLE' in st else 'U'
        ok = (cls == docl) and any(v == int(p) and l == br for l,v in pr)
        msg = r"document : $P=%s$, état %s, branche %s ; calcul : %d premier(s) %s" % (fmt(int(p)), 'C\\_MULTIPLE' if docl == 'M' else 'unique', br.replace('-','$-$').replace('+','$+$'), len(pr), ", ".join("%s $%s$" % (l.replace('-','$-$').replace('+','$+$'), fmt(v)) for l,v in pr) or "aucun")
    rec(r"table 3.7, $k=%d$" % k, ok)
    if not ok: ecarts.append(r"$k=%d$ : %s \hfill %s" % (k, msg, KOC))
resume(r"section 3.7 : table $P(1/k)$, $n=10$, $k=10$ à $111$ (102 lignes recalculées)", nb, ecarts)
