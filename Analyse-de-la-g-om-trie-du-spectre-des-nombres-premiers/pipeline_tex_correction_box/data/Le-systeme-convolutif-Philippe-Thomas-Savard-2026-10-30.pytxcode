good = set()
for k in (13, 42, 54):
    for v in A_terms(k,15) + B_terms(k,15) + [k**6, k**7, k**12, k**13]:
        good.add(str(v))
    for v in (SAf(k,15), SBf(k,15), SAf(k,10), SBf(k,10), SAf(k,15)-SAf(k,10), SBf(k,15)-SBf(k,10)):
        good.add(str(int(v)))
    for f in (aAf(k), aBf(k), dAf(k), dBf(k)):
        good.add(str(f.numerator)); good.add(str(f.denominator))
    d = DOC15[k]
    for kk in ('P10','rb','rc','P15','Dig15'):
        good.add(str(d[kk]))
    for l,v in cands(k):
        good.add(str(v))
    for p,sg,dg,pc,e in d['trials']:
        good.add(str(dg)); good.add(str(pc))
