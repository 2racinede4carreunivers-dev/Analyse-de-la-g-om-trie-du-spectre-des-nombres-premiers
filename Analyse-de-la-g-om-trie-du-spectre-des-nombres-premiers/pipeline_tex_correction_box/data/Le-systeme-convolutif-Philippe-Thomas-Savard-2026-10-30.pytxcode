def nb_ancrages(a, b):
    return sum(1 for k in range(a, b + 1) if any(mr(v) for l,v in cands(k)))
egal(r"rapports traités $k=2..1001$", 1001-2+1, 1000)
c1 = nb_ancrages(2, 1001); egal(r"succès annoncés pour $k=2..1001$", c1, 423)
egal(r"rapports traités $k=1002..10001$", 10001-1002+1, 9000)
c2 = nb_ancrages(1002, 10001); egal(r"succès annoncés pour $k=1002..10001$", c2, 2604)
c3 = nb_ancrages(10002, 100001); egal(r"lignes « PREMIER TROUVE » pour $k=10002..100001$", c3, 19215)
