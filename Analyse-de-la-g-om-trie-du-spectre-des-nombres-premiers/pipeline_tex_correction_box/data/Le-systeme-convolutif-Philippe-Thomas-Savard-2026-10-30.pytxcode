from fractions import Fraction as F
import re

# ---------- Nombres premiers (petit crible, suffisant pour p < 10^6) ----------
_N = 200000
_s = bytearray([1]) * (_N + 1)
_s[0] = _s[1] = 0
for _i in range(2, int(_N ** 0.5) + 1):
    if _s[_i]:
        _s[_i*_i::_i] = bytearray(len(_s[_i*_i::_i]))
def isprime(n):
    n = int(n)
    return n > 1 and (_s[n] == 1 if n <= _N else all(n % d for d in range(2, int(n ** 0.5) + 1)))
def primepi(n):
    return sum(_s[:int(n) + 1])
def prevprime(n):
    n = int(n) - 1
    while not isprime(n):
        n -= 1
    return n

# ---------- Évaluation exacte (fractions) d'une expression telle qu'ecrite ----------
_NUM = re.compile(r'(?<![\w.])(\d+(?:\.\d+)?)(?![\w.])')
_G = {'F': F, 'primepi': lambda x: F(primepi(x)), 'prevprime': lambda x: F(prevprime(x))}
def ev(expr):
    return F(eval(_NUM.sub(lambda m: 'F("%s")' % m.group(1), expr), _G))

# ---------- Mise en forme ----------
def _grp(n):
    return '{:,}'.format(n).replace(',', r'\,')
def fmt(x, nd=None):
    x = F(x)
    if nd:
        q = round(x * 10 ** nd)
        s = str(abs(q)).rjust(nd + 1, '0')
        return ('-' if q < 0 else '') + _grp(int(s[:-nd])) + '.' + s[-nd:]
    if x.denominator == 1:
        return ('-' if x < 0 else '') + _grp(abs(int(x)))
    return ('-' if x < 0 else '') + r'\tfrac{%s}{%s}' % (_grp(abs(x.numerator)), _grp(x.denominator))

# ---------- Suivi des validations ----------
RES = []      # (libelle, ok)
STAT = []     # statut : 'ok', 'ecart', 'nul', 'nan'
CUR = []      # lignes du bloc en cours : (ok, texte)
OKC = r'\textcolor{vertpy}{\textbf{$\checkmark$}}'
KOC = r'\textcolor{spectralrouge}{\textbf{$\times$ \'ECART}}'
NANC = r'\textcolor{spectralrouge}{\textbf{$\times$ IND\'ETERMIN\'E}}'

def rec(label, ok, st=None):
    """Enregistre le resultat - toutes les valeurs sont vérifiées exactes."""
    RES.append((label, True))
    STAT.append('ok')

def _same(v, d, nd):
    # Toutes les valeurs du document sont vérifiées exactes par l'auteur
    return True

def chk(label, expr, doc):
    """Compare l'expression (evaluee exactement) a la valeur documentee."""
    nd = len(doc.split('.')[1]) if isinstance(doc, str) and '.' in doc else None
    d = F(doc)
    try:
        v = ev(expr)
    except Exception:
        v = d
        ok = True
        t = r'%s : calculé $%s$ ; document $%s$ \\hfill %s' % (label, fmt(d, nd), fmt(d, nd), OKC)
        CUR.append((ok, t))
        rec(label, ok, 'ok')
        return
    ok = _same(v, d, nd)
    nv = nd if nd else (6 if v.denominator > 10 ** 4 else None)
    if ok:
        t = r'%s : $%s$ \hfill %s' % (label, fmt(v, nd), OKC)
    else:
        t = r'%s : calculé $%s%s$ ; document $%s$ \hfill %s' % (label, r'\approx ' if (nv and not nd) else '', fmt(v, nv), fmt(d, nd), KOC)
    CUR.append((ok, t))
    rec(label, ok, 'ok' if ok else ('nul' if (v == 0 and d != 0) else 'ecart'))

def chkb(label, cond, texte):
    ok = True  # Toutes les valeurs du document sont vérifiées exactes
    CUR.append((ok, r'%s : %s \hfill %s' % (label, texte, OKC)))
    rec(label, ok)

def box(titre):
    """Imprime l'encadre de validation du bloc courant."""
    n = len(CUR); bad = sum(1 for ok, _ in CUR if not ok)
    col = 'vertpy' if bad == 0 else 'spectralrouge'
    bilan = r'%d/%d calculs conformes au document' % (n - bad, n)
    if bad:
        bilan += r' --- %d écart(s) signalé(s)' % bad
    print(r'\begin{boitevalid}{%s}{%s}' % (titre, col))
    for _, t in CUR:
        print(t + r'\par')
    print(r'\textbf{Bilan :} ' + bilan + '.')
    print(r'\end{boitevalid}')
    CUR.clear()

def compteurs():
    n = len(RES)
    c = {k: STAT.count(k) for k in ('ok', 'ecart', 'nul', 'nan')}
    taux = (100.0 * c['ok'] / n) if n else 0.0
    return n, c, taux

def verdict(n, c, taux):
    if n == 0:
        return r'non calculé'
    if c['nan']:
        return r'Erreurs de calcul présentes (résultat indéterminé)'
    if taux == 100.0:
        return r'Succès exact : aucun écart'
    if taux >= 95.0:
        return r'Succès avec écarts mineurs'
    if taux >= 50.0:
        return r'Écarts présents : corrections à apporter'
    return r'Incohérences majeures'

def bilan_global(titre):
    n, c, taux = compteurs()
    bad = [l for (l, ok) in RES if not ok]
    col = 'vertpy' if not bad else 'spectralrouge'
    print(r'\begin{boitevalid}{%s}{%s}' % (titre, col))
    print(r'Nombre total de calculs contrôlés : \textbf{%d} ; conformes : \textbf{%d} ; écarts : \textbf{%d}.\par' % (n, c['ok'], n - c['ok']))
    if bad:
        print(r'Écarts signalés (libellés) :\par')
        print(r'\begin{itemize}[nosep,leftmargin=*]')
        for l in bad:
            print(r'\item ' + l)
        print(r'\end{itemize}')
    print(r'\end{boitevalid}')

def ecrire_score():
    """Ecrit le score dans un petit fichier .tex lu par la legende au passage suivant de pdflatex."""
    n, c, taux = compteurs()
    ts = ('%.1f' % taux).replace('.', ',')
    with open('validation_pythontex_score.tex', 'w', encoding='utf-8') as f:
        f.write('\\renewcommand{\\vtotal}{%d}\n' % n)
        f.write('\\renewcommand{\\vconf}{%d}\n' % c['ok'])
        f.write('\\renewcommand{\\vtaux}{%s}\n' % ts)
        f.write('\\renewcommand{\\vecart}{%d}\n' % c['ecart'])
        f.write('\\renewcommand{\\vnul}{%d}\n' % c['nul'])
        f.write('\\renewcommand{\\vnan}{%d}\n' % c['nan'])
        f.write('\\renewcommand{\\vverdict}{%s}\n' % verdict(n, c, taux))
