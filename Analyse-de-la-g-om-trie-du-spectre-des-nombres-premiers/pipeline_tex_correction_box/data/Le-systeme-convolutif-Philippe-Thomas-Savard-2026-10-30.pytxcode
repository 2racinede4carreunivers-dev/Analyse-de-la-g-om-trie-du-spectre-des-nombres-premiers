def aA(k): return F(2*(k**4-k**2+1), (k-1)*k**3)
def aB(k): return k*aA(k)
def dA(k): return F(k, k-1)
def dB(k): return F(k**7-k**6+k, k-1)
def SA(k,n): return aA(k)/2*k**n-dA(k)
def SB(k,n): return aB(k)/2*k**n-dB(k)
doc = {3:(79824,238746,F(3,2),F(1461,2)), 4:(1316180,5260628,F(4,3),3073*F(4,3)), 5:(11738280,58675780,F(5,4),12501*F(5,4)),
       6:(70599858,423552498,F(6,5),38881*F(6,5)), 7:(322966112,2260645142,F(7,6),100843*F(7,6))}
xv = {3:6, 4:12, 5:20, 6:30, 7:42}
coefA = {3:F(73,9), 4:F(241,16), 5:F(601,25), 6:F(1261,36), 7:F(2353,49)}
coefB = {3:F(219,9), 4:F(241,4), 5:F(601,5), 6:F(1261,6), 7:F(2353,7)}
for k in (3,4,5,6,7):
    a,b,da,db = doc[k]
    CUR.append((SA(k,10)==a and SB(k,10)==b, r"$k=%d$ : $S_A(k,10)=\tfrac{\alpha_A}{2}k^{10}-\delta_A=%s$ et $S_B(k,10)=%s$ \hfill %s" % (k, fmt(SA(k,10)), fmt(SB(k,10)), OKC if (SA(k,10)==a and SB(k,10)==b) else KOC)))
    rec(r"formules fermées, $k=%d$, $n=10$" % k, SA(k,10)==a and SB(k,10)==b)
    ok = (dA(k)==da and dB(k)==db)
    CUR.append((ok, r"$k=%d$ : $\delta_A=%s$ et $\delta_B=%s$ égalent le « Reste » des sections 2.x \hfill %s" % (k, fmt(dA(k)), fmt(dB(k)), OKC if ok else KOC)))
    rec(r"constantes $\delta_A,\delta_B$, $k=%d$" % k, ok)
    ok = (coefA[k]/xv[k]==aA(k)/2 and coefB[k]/xv[k]==aB(k)/2 and xv[k]==k*(k-1))
    CUR.append((ok, r"$k=%d$ : $x=%d=k(k-1)$ ; $\text{Coefficient }A/x=\alpha_A/2$ et $\text{Coefficient }B/x=\alpha_B/2$ \hfill %s" % (k, xv[k], OKC if ok else KOC)))
    rec(r"coefficients $A,B$ et $x$, $k=%d$" % k, ok)
for k in (3,4,5,6,7):
    ok = all(F(SA(k,n1)-SA(k,n2), 1)/ (SB(k,n1)-SB(k,n2)) == F(1,k) for n1,n2 in ((10,9),(10,8),(12,9),(15,10)))
    CUR.append((ok, r"$k=%d$ : invariant spectral $\dfrac{S_A(k,n_1)-S_A(k,n_2)}{S_B(k,n_1)-S_B(k,n_2)}=\dfrac1k$ (4 couples $(n_1,n_2)$) \hfill %s" % (k, OKC if ok else KOC)))
    rec(r"invariant spectral, $k=%d$" % k, ok)
box(r"sections 3.1 et 3.2 : constantes, formules fermées et invariant spectral")

